# Deepclario environment variables.
# Copy this file to `.env.local` and fill in real values. `.env.local` is
# gitignored and must never be committed. In production, set the same names
# in Vercel → Project → Settings → Environment Variables.

# ---- AI providers ----
# Prompt-improvement engine (src/lib/engine). Uses OpenAI gpt-4.1-nano.
OPENAI_API_KEY=sk-...

# AI detector feature (src/lib/detector) still uses Gemini. Only needed if
# the detector is enabled.
GEMINI_API_KEY=

# ---- Supabase (auth + database) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Google Sign-In (Google Identity Services) ----
# Web OAuth Client ID from Google Cloud Console. The login page runs Google
# Identity Services against THIS client (branded "Deepclario"), so the Google
# consent screen shows our domain instead of <ref>.supabase.co. The same Client
# ID must be pasted into Supabase → Auth → Providers → Google → Authorized
# Client IDs so signInWithIdToken trusts our tokens.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ---- Social sign-in (redirect OAuth via Supabase) ----
# Each flag shows a "Continue with …" button on /login. Set a flag to true
# ONLY after enabling that provider in Supabase → Auth → Providers,
# otherwise clicking the button fails with a 400.
# GitHub: create an OAuth app (github.com/settings/developers) with callback
#   https://<project-ref>.supabase.co/auth/v1/callback
NEXT_PUBLIC_ENABLE_GITHUB_AUTH=false
# X / Twitter:
NEXT_PUBLIC_ENABLE_TWITTER_AUTH=false
# Google via plain redirect OAuth - the fallback when no GIS client ID is
# configured above. Ignored on /login while NEXT_PUBLIC_GOOGLE_CLIENT_ID is
# set (GIS keeps the consent screen branded as Deepclario).
NEXT_PUBLIC_ENABLE_GOOGLE_AUTH=false

# ---- App ----
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Billing (Paddle) ----
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRO_MONTHLY_PRICE_ID=
PADDLE_PRO_ANNUAL_PRICE_ID=
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
NEXT_PUBLIC_PADDLE_LIVE=false

# ---- Browser extension (optional) ----
# The connect page hands a token to the extension by messaging it by ID.
#
# The published store ID is NOT here: it is a public, permanent value and now
# lives in src/lib/constants.ts as CHROME_EXTENSION_ID. It used to be the env
# var below, was never set in production, and silently defaulted to empty -
# which told every user "we could not find the extension". Only set the STORE
# override if you are pointing at a differently signed build.
# NEXT_PUBLIC_EXTENSION_ID_STORE=
#
# Set this to test the one-click connect against a LOCALLY loaded unpacked
# build. Chrome generates a different ID per unpacked extension per machine;
# chrome://extensions shows it. Without it the page falls back to the manual
# code, which is correct behaviour, not a bug.
NEXT_PUBLIC_EXTENSION_ID_DEV=

# ---- Observability (optional) ----
NEXT_PUBLIC_SENTRY_DSN=

# ---- Fact checker: retrieval (Phase 4a) ----
# Tavily. One key covers both endpoints the citation axis uses: /extract for a
# claim that carries a hyperlink, and /search with include_domains for one that
# names a publisher without linking it. No scopes, no per-endpoint keys.
#
# Free tier is 1,000 credits a month with no card. A 20-claim document costs
# about 4 credits, so roughly 250 documents a month cost nothing.
#
# WITHOUT THIS THE CITATION AXIS IS INERT, NOT BROKEN. The provider returns
# `not_configured`, every claim keeps `not_applicable`, and the page says the
# sources were not checked. It never produces a sentence about somebody's link.
TAVILY_API_KEY=
